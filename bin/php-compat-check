#!/usr/bin/env bash

set -e
trap 'exit 2' ERR

SCRIPT_PATH=${BASH_SOURCE[0]}
[[ "$SCRIPT_PATH" == */* ]] || SCRIPT_PATH="./$SCRIPT_PATH"
SCRIPT_DIR=$(cd -- "${SCRIPT_PATH%/*}" && pwd)
VERSION_FILE="$SCRIPT_DIR/../VERSION"
if [ ! -f "$VERSION_FILE" ]; then
  VERSION_FILE="$SCRIPT_DIR/../share/php-compat-check/VERSION"
fi
IFS= read -r VERSION < "$VERSION_FILE"
IMAGE="${PHP_COMPAT_CHECK_IMAGE:-zoliszabo/php-compat-check:$VERSION}"
JSON_MODE=0
JSON_DELIVERED=0
JSON_OUTPUT=""
for arg in "$@"; do
  case "$arg" in --format=json) JSON_MODE=1 ;; --format=text) JSON_MODE=0 ;; esac
done
for arg in "$@"; do
  case "$arg" in -h|--help|--version) JSON_MODE=0 ;; esac
done
finish_output() {
  local status=$?
  trap - EXIT
  if [ "$JSON_MODE" -eq 1 ] && [ "$JSON_DELIVERED" -eq 0 ]; then
    printf '%s\n' '{"schema_version":1,"tool_version":null,"mode":null,"source":null,"scan":null,"results":[],"summary":{"status":"error","version":null,"upper_incompatibility_found":null},"diagnostics":[{"level":"error","message":"Unable to start compatibility analysis; see stderr."}],"exit_code":2}' >&3
    status=2
  fi
  [ -z "$JSON_OUTPUT" ] || rm -f -- "$JSON_OUTPUT"
  exit "$status"
}
trap finish_output EXIT
if [ "$JSON_MODE" -eq 1 ]; then
  exec 3>&1
  exec 1>&2
fi

# Helper functions
echo_error() { echo -e "\033[31m[ERROR]\033[0m $1"; }
echo_info() { echo -e "\033[34m[INFO]\033[0m $1"; }
echo_warning() { echo -e "\033[33m[WARNING]\033[0m $1"; }

print_help() {
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    printf '%s\n' "$line"
  done < "${VERSION_FILE%/*}/HELP"
}

build_dev_image() {
  local context="${VERSION_FILE%/*}" file context_version
  [ -f "$context/docker/Dockerfile" ] || context="$context/source"
  for file in VERSION HELP docker/Dockerfile docker/report.php docker/bin/php-compat-check; do
    if [ ! -f "$context/$file" ]; then
      echo_error "Development build sources are missing. Reinstall from a complete checkout with make install, or set PHP_COMPAT_CHECK_IMAGE."
      exit 2
    fi
  done
  IFS= read -r context_version < "$context/VERSION"
  if [ "$context_version" != "$VERSION" ]; then
    echo_error "Development build sources do not match launcher version $VERSION. Reinstall with make install."
    exit 2
  fi
  context=$(cd -- "$context" && pwd -P)
  echo_info "Building development image $IMAGE ..."
  docker build -t "$IMAGE" -f "$context/docker/Dockerfile" "$context" >&2
}

if [ "$#" -eq 0 ]; then
  print_help
  exit 2
fi

# Reject unknown options before invoking Docker, regardless of argument order.
ARGS=("$@")
for i in "${!ARGS[@]}"; do
  arg="${ARGS[$i]}"
  case "$arg" in
    -h|--help)
      print_help
      exit 0
      ;;
    --version)
      echo "php-compat-check $VERSION"
      exit 0
      ;;
    --version=*)
      echo_warning "--version=<ref> is deprecated; use --source-version=<version> instead." >&2
      ARGS[$i]="--source-version=${arg#*=}"
      ;;
    --format=json|--format=text) ;;
    --format=*)
      echo_error "Invalid output format: ${arg#*=}. Use text or json."
      exit 2
      ;;
    --check-deps|--check-deps=*|--min-php-version|--max-php-version|--matrix|--from-php-version=*|--to-php-version=*|\
    --ignore-composer-php-version|--show-deps|--show-warnings|--scan-dirs=*|--source-version=*) ;;
    -*)
      echo_error "Unknown option: $arg"
      exit 2
      ;;
  esac
done

# Detect Docker
if ! command -v docker >/dev/null 2>&1; then
  echo_error "Docker is not installed or not in PATH."
  exit 2
fi

BUILD_DEV=0
if [[ "$VERSION" == *-dev ]] && [ -z "${PHP_COMPAT_CHECK_IMAGE:-}" ]; then
  BUILD_DEV=1
fi

# Only explicit paths are local; vendor/package always remains Packagist shorthand.
MOUNT_ARGS=(-v "$(pwd):/work" -w /work)
ORIGINAL_SOURCE=""
for i in "${!ARGS[@]}"; do
  source_arg="${ARGS[$i]}"
  [[ "$source_arg" == --* ]] && continue
  ORIGINAL_SOURCE="$source_arg"
  case "$source_arg" in
    local:*) local_path="${source_arg#local:}" ;;
    .|..|./*|../*|/*) local_path="$source_arg" ;;
    *) break ;;
  esac
  if [ -z "$local_path" ] || [ ! -d "$local_path" ]; then
    echo_error "Local directory not found: $local_path"
    exit 2
  fi
  local_path=$(cd -- "$local_path" && pwd -P)
  MOUNT_ARGS=(-v "$local_path:/project:ro" -w /project)
  ARGS[$i]="local:/project"
  break
done

# Rebuild development code on each run, reusing Docker's layer cache.
if [ "$BUILD_DEV" -eq 1 ]; then
  build_dev_image
elif ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo_info "Image not found locally. Pulling $IMAGE ..."
  docker pull "$IMAGE"
fi

# Local sources are mounted read-only, even when dependency checks are requested.
result=0
DOCKER_ARGS=(run --rm "${MOUNT_ARGS[@]}" -e "PHP_COMPAT_CHECK_SOURCE=$ORIGINAL_SOURCE" "$IMAGE" php-compat-check "${ARGS[@]}")
if [ "$JSON_MODE" -eq 1 ]; then
  JSON_OUTPUT=$(mktemp)
  docker "${DOCKER_ARGS[@]}" > "$JSON_OUTPUT" || result=$?
  if [ -s "$JSON_OUTPUT" ]; then
    cat "$JSON_OUTPUT" >&3
    JSON_DELIVERED=1
  else
    result=2
  fi
else
  docker "${DOCKER_ARGS[@]}" || result=$?
fi
case "$result" in
  0|1|2) exit "$result" ;;
  *) exit 2 ;;
esac
