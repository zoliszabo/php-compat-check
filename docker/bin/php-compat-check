#!/usr/bin/env bash

set -e
trap 'exit 2' ERR

SCRIPT_PATH=${BASH_SOURCE[0]}
[[ "$SCRIPT_PATH" == */* ]] || SCRIPT_PATH="./$SCRIPT_PATH"
SCRIPT_DIR=$(cd -- "${SCRIPT_PATH%/*}" && pwd)
VERSION_FILE="$SCRIPT_DIR/../../VERSION"
if [ ! -f "$VERSION_FILE" ]; then
  VERSION_FILE="$SCRIPT_DIR/../share/php-compat-check/VERSION"
fi
IFS= read -r VERSION < "$VERSION_FILE"

# Helper functions
echo_error() { echo -e "\033[31m[ERROR]\033[0m $1"; json_diagnostic error "$1"; }
echo_info() { echo -e "\033[34m[INFO]\033[0m $1"; }
echo_success() { echo -e "\033[32m[SUCCESS]\033[0m $1"; }
echo_warning() { echo -e "\033[33m[WARNING]\033[0m $1"; json_diagnostic warning "$1"; }
echo_note() { echo -e "\033[37m[NOTE]\033[0m $1"; }

print_help() {
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    printf '%s\n' "$line"
  done < "${VERSION_FILE%/*}/HELP"
}

# -----------------------
# CONFIG
# -----------------------
PHP_VERSIONS=("5.6" "7.0" "7.1" "7.2" "7.3" "7.4" "8.0" "8.1" "8.2" "8.3" "8.4" "8.5")
MAX_PHP_VERSION="${PHP_VERSIONS[-1]}"

JSON_MODE=0
REPORT_DIR=""
TMP_DIR=""
REPORT_HELPER="$SCRIPT_DIR/../report.php"
[ -f "$REPORT_HELPER" ] || REPORT_HELPER="$SCRIPT_DIR/../share/php-compat-check/report.php"
for arg in "$@"; do
  case "$arg" in --format=json) JSON_MODE=1 ;; --format=text) JSON_MODE=0 ;; esac
done
for arg in "$@"; do
  case "$arg" in -h|--help|--version) JSON_MODE=0 ;; esac
done

json_fallback() {
  printf '%s\n' '{"schema_version":1,"tool_version":null,"mode":null,"source":null,"scan":null,"results":[],"summary":{"status":"error","version":null,"upper_incompatibility_found":null},"diagnostics":[{"level":"error","message":"Unable to start compatibility analysis; see stderr."}],"exit_code":2}' >&3
}

finish_output() {
  local status=$? known_json="[" separator="" v
  trap - EXIT
  case "$status" in 0|1|2) ;; *) status=2 ;; esac
  if [ "$JSON_MODE" -eq 1 ]; then
    for v in "${PHP_VERSIONS[@]}"; do
      known_json+="$separator\"$v\""
      separator=,
    done
    known_json+="]"
    if [ -n "$REPORT_DIR" ] && command -v php >/dev/null && [ -f "$REPORT_HELPER" ]; then
      if ! printf '%s' "$known_json" | php "$REPORT_HELPER" finish "$REPORT_DIR" "$status" "$VERSION" \
        "${MODE:-check}" "${ORIGINAL_REPO:-${REPO:-}}" "${SOURCE_TYPE:-}" "${CLONED_VERSION:-}" "${CLONED_HASH:-}" \
        "${FROM_PHP_VERSION:-${PHP_VERSION:-}}" "${TO_PHP_VERSION:-${PHP_VERSION:-}}" "${ROOT_PHP_CONSTRAINT:-}" \
        "${IGNORE_COMPOSER_PHP_VERSION:-0}" "${CHECK_DEPS:-}" "${RESULT_VERSION:-}" >&3; then
        json_fallback
        status=2
      fi
    else
      json_fallback
      status=2
    fi
  fi
  [ -z "$TMP_DIR" ] || rm -rf -- "$TMP_DIR"
  [ -z "$REPORT_DIR" ] || rm -rf -- "$REPORT_DIR"
  exit "$status"
}
trap finish_output EXIT
if [ "$JSON_MODE" -eq 1 ]; then
  exec 3>&1
  exec 1>&2
  REPORT_DIR=$(mktemp -d)
fi

json_diagnostic() {
  if [ "$JSON_MODE" -eq 1 ] && [ -n "$REPORT_DIR" ] && command -v php >/dev/null && [ -f "$REPORT_HELPER" ]; then
    php "$REPORT_HELPER" diagnostic "$REPORT_DIR" "$1" "$2" || true
  fi
}

record_result() {
  [ "$JSON_MODE" -eq 1 ] || return 0
  if [ "$2" = excluded ]; then printf '{}\n' > "$REPORT_DIR/current.json"; fi
  printf '%s' "${DEPENDENCY_PACKAGES:-[]}" | php "$REPORT_HELPER" result "$REPORT_DIR" \
    "$1" "$2" "$3" "$PROJECT_DIR" "$CHECK_DEPS" "$SOURCE_TYPE" "$COMPOSER_HOME"
}

# -----------------------
# FUNCTIONS
# -----------------------
resolve_php_version() {
  local composer_php=""
  local runtime_php=""

  if [ -f composer.json ]; then
    composer_php=$(jq -r '.require.php // empty' composer.json 2>/dev/null || true)
  fi

  runtime_php=$(php -r 'echo PHP_VERSION;' 2>/dev/null || true)

  echo ""
  echo_warning "PHP version not provided."
  echo ""

  [ -n "$composer_php" ] && echo "composer.json: $composer_php"
  [ -z "$composer_php" ] && echo "composer.json: (not found)"

  [ -n "$runtime_php" ] && echo "runtime PHP: $runtime_php"
  [ -z "$runtime_php" ] && echo "runtime PHP: (not available)"

  echo ""
  echo "Please provide: <php-version>"
  echo ""

  exit 2
}


detect_scan_dirs() {
  if [ ! -f composer.json ]; then
    echo "."
    return
  fi

  local dirs files combined
  dirs=$(jq -r '
    (
      [.autoload["psr-4"] // {} | to_entries[] | .value | if type == "array" then .[] else . end] +
      [.autoload["psr-0"] // {} | to_entries[] | .value | if type == "array" then .[] else . end] +
      (.autoload.classmap // [])
    ) | .[] | split("/")[0]
  ' composer.json 2>/dev/null | sort -u || true)

  files=$(jq -r '.autoload.files // [] | .[]' composer.json 2>/dev/null || true)

  combined=$(printf '%s\n%s\n' "$dirs" "$files" | sort -u | grep -v '^$' || true)

  if [ -z "$combined" ]; then
    echo "."
  else
    echo "$combined"
  fi
}

detect_polyfill_standards() {
  local packages="$1"
  local standards=()

  local symfony_versions=("54" "55" "56" "70" "71" "72" "73" "74" "80" "81" "82" "83" "84" "85")
  for ver in "${symfony_versions[@]}"; do
    if echo "$packages" | grep -qx "symfony/polyfill-php${ver}"; then
      standards+=("PHPCompatibilitySymfonyPolyfillPHP${ver}")
    fi
  done

  if echo "$packages" | grep -qx "paragonie/random_compat"; then
    standards+=("PHPCompatibilityParagonieRandomCompat")
  fi
  if echo "$packages" | grep -qx "paragonie/sodium_compat"; then
    standards+=("PHPCompatibilityParagonieSodiumCompat")
  fi
  if echo "$packages" | grep -qx "ircmaxell/password-compat"; then
    standards+=("PHPCompatibilityPasswordCompat")
  fi

  [ ${#standards[@]} -gt 0 ] && printf '%s\n' "${standards[@]}"
}

satisfies_php_constraint() {
  php -r '
    require $argv[1] . "/vendor/autoload.php";
    exit(Composer\Semver\Semver::satisfies($argv[2], $argv[3]) ? 0 : 1);
  ' "$COMPOSER_HOME" "$1" "$2"
}

constraint_min_version() {
  local versions_json
  versions_json=$(printf '%s\n' "${PHP_VERSIONS[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')
  php -r '
    require $argv[1] . "/vendor/autoload.php";
    $matching = Composer\Semver\Semver::satisfiedBy(json_decode($argv[2], true), $argv[3]);
    $sorted = Composer\Semver\Semver::sort($matching);
    echo $sorted[0] ?? "";
  ' "$COMPOSER_HOME" "$versions_json" "$1"
}

validate_php_constraints() {
  php -r '
    require $argv[1] . "/vendor/autoload.php";
    $parser = new Composer\Semver\VersionParser();
    foreach (json_decode(stream_get_contents(STDIN), true) as $constraint) {
        if (!is_string($constraint)) exit(1);
        if ($constraint !== "") $parser->parseConstraints($constraint);
    }
  ' "$COMPOSER_HOME"
}

select_mode() {
  if [ "$MODE" != check ] && [ "$MODE" != "$1" ]; then
    echo_error "Choose only one of --min-php-version, --max-php-version, or --matrix."
    exit 2
  fi
  MODE="$1"
}

known_php_version() {
  local v
  for v in "${PHP_VERSIONS[@]}"; do
    [ "$v" != "$1" ] || return 0
  done
  return 1
}

select_scan_versions() {
  local v active=0
  SCAN_PHP_VERSIONS=()
  for v in "${PHP_VERSIONS[@]}"; do
    [ "$v" != "$FROM_PHP_VERSION" ] || active=1
    [ "$active" -eq 0 ] || SCAN_PHP_VERSIONS+=("$v")
    [ "$v" != "$TO_PHP_VERSION" ] || break
  done
}

# Read metadata rather than loading the project's autoloader or executing its code.
collect_vendor_ignores() {
  local target_version="$1"
  local compatible="$2"
  php -r '
    require $argv[1] . "/vendor/autoload.php";
    foreach (json_decode(stream_get_contents(STDIN), true) as $package) {
        $constraint = $package["require"]["php"] ?? "";
        if ($constraint !== "" && Composer\Semver\Semver::satisfies($argv[2], $constraint) === ($argv[3] === "1")) {
            echo "vendor/" . $package["name"] . PHP_EOL;
        }
    }
  ' "$COMPOSER_HOME" "$target_version" "$compatible" <<< "$DEPENDENCY_PACKAGES"
}

load_local_dependencies() {
  DEPENDENCY_PACKAGES='[]'
  LOCAL_DEV_PACKAGES=()
  if [ ! -f vendor/composer/installed.json ]; then
    if [ -f composer.json ] && jq -e '
      .require // {} | keys | any(test("^[^/]+/[^/]+$"))
    ' composer.json >/dev/null; then
      echo_error "Installed dependency metadata not found. Run Composer install in the local project first."
      return 1
    fi
    return 0
  fi

  # Composer 2 identifies dev-only packages; Composer 1 can use the lock file.
  local installed_packages
  if ! installed_packages=$(jq -cse '
    if length == 1 then .[0] else error("Expected one metadata document") end |
    if type == "array" then .
    elif (.packages | type) == "array" then .packages
    else error("Invalid installed package metadata") end
  ' vendor/composer/installed.json); then
    echo_error "Could not read installed dependency metadata. Run Composer install in the local project first."
    return 1
  fi
  if jq -e 'type == "object"' vendor/composer/installed.json >/dev/null; then
    mapfile -t LOCAL_DEV_PACKAGES < <(jq -r '.["dev-package-names"] // [] | .[]' vendor/composer/installed.json)
  elif [ -f composer.lock ]; then
    mapfile -t LOCAL_DEV_PACKAGES < <(jq -r '.["packages-dev"] // [] | .[].name' composer.lock)
  fi
  local dev_json
  dev_json=$(printf '%s\n' "${LOCAL_DEV_PACKAGES[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')
  DEPENDENCY_PACKAGES=$(jq -c --argjson dev "$dev_json" '
    [.[] | select(.name as $name | $dev | index($name) | not)]
  ' <<< "$installed_packages")
  if ! jq -c '[.[].require.php // ""]' <<< "$DEPENDENCY_PACKAGES" | validate_php_constraints; then
    echo_error "Invalid PHP requirement in installed dependency metadata."
    return 1
  fi

  if ! php -r '
    $root = is_file("composer.json") ? json_decode(file_get_contents("composer.json"), true) : [];
    $packages = json_decode(stream_get_contents(STDIN), true);
    $available = [];
    foreach (array_merge([$root], $packages) as $package) {
        if (isset($package["name"])) $available[$package["name"]] = true;
        foreach (["provide", "replace"] as $key) {
            foreach ($package[$key] ?? [] as $name => $_) $available[$name] = true;
        }
    }
    $missing = [];
    foreach (array_merge([$root], $packages) as $package) {
        foreach ($package["require"] ?? [] as $name => $_) {
            if (str_contains($name, "/") && !isset($available[$name])) $missing[$name] = true;
        }
    }
    foreach ($missing as $name => $_) echo "Missing installed dependency: $name" . PHP_EOL;
    exit($missing ? 1 : 0);
  ' <<< "$DEPENDENCY_PACKAGES"; then
    echo_error "Dependencies are incomplete. Run Composer install in the local project first."
    return 1
  fi

  local missing=0 package
  while IFS= read -r package; do
    if [ ! -d "vendor/$package" ]; then
      echo_error "Installed dependency directory missing: vendor/$package. Run Composer install in the local project first."
      missing=1
    fi
  done < <(jq -r '.[] | select(.type != "metapackage") | .name' <<< "$DEPENDENCY_PACKAGES")
  [ "$missing" -eq 0 ]
}

print_config() {
  local mode="$1"
  local php_info="$2"
  local version_display="${CLONED_VERSION}${CLONED_HASH:+, ${CLONED_HASH}}"

  local composer_php=""
  if [ -f composer.json ]; then
    composer_php=$(jq -r '.require.php // empty' composer.json 2>/dev/null || true)
  fi
  local composer_php_display="${composer_php:-none}"
  [ "$IGNORE_COMPOSER_PHP_VERSION" -eq 1 ] && [ -n "$composer_php" ] && composer_php_display="${composer_php} (ignored)"

  echo ""
  echo_info "Source:                  ${ORIGINAL_REPO} (${version_display})"
  echo_info "PHP:                     ${php_info}"
  echo_info "Mode:                    ${mode}"
  echo_info "Check deps:              ${CHECK_DEPS:-no}"
  echo_info "Composer PHP constraint: ${composer_php_display}"
  echo_info "Scan dirs:               ${SCAN_DIRS[*]}"
  echo_info "Standards:               ${PHPCS_STANDARDS}"
  echo ""
}

run_check() {
  local result=0 status
  CHECK_REASON=""
  if [ "$JSON_MODE" -eq 1 ]; then printf '{}\n' > "$REPORT_DIR/current.json"; fi
  perform_check "$@" || result=$?
  case "$result" in
    0) status=compatible ;;
    1) status=incompatible ;;
    *) status=error; result=2 ;;
  esac
  record_result "$1" "$status" "$CHECK_REASON" || return 2
  return "$result"
}

perform_check() {
  local version="$1"
  local verbose="${2:-0}"
  local target="${version}"
  local phpcs_ignore="*/vendor/composer/*,*/vendor/autoload.php,*/polyfill-*/bootstrap*.php"

  local scan_dirs=("${SCAN_DIRS[@]}")
  local dependency_constraint_fails=0
  PHPCS_STANDARDS="$BASE_PHPCS_STANDARDS"
  if [ "$SOURCE_TYPE" = "local" ]; then
    if [ -z "$CHECK_DEPS" ]; then
      phpcs_ignore="${phpcs_ignore},*/vendor/*"
    else
      local dev_package
      for dev_package in "${LOCAL_DEV_PACKAGES[@]}"; do
        phpcs_ignore="${phpcs_ignore},*/vendor/${dev_package}/*"
      done
    fi
  fi

  local php_constraint_fails=0
  local php_constraint_value=""
  if [ "$IGNORE_COMPOSER_PHP_VERSION" -eq 0 ] && [ -f composer.json ]; then
    php_constraint_value=$(jq -r '.require.php // empty' composer.json 2>/dev/null || true)
    if [ -n "$php_constraint_value" ] && ! satisfies_php_constraint "$version" "$php_constraint_value"; then
      php_constraint_fails=1
    fi
  fi

  if [ "$php_constraint_fails" -eq 1 ]; then
    CHECK_REASON=composer_constraint
    echo_error "PHP $version does not satisfy the project's requirement: $php_constraint_value"
    echo_note "Use --ignore-composer-php-version to bypass this check."
    return 1
  fi

  if [ -n "$CHECK_DEPS" ]; then
    if [ "$SOURCE_TYPE" != "local" ]; then
      DEPENDENCY_PACKAGES='[]'
      CHECK_REASON=composer_error
      rm -rf vendor composer.lock

      jq --argjson ignore "$IGNORE_COMPOSER_PHP_VERSION" '
        del(.["require-dev"], .["autoload-dev"]) |
        if $ignore == 1 then del(.require.php) else . end
      ' composer.json > composer.tmp.json || return 2
      mv composer.tmp.json composer.json || return 2
      composer config platform.php "$version" || return 2

      local composer_output
      local composer_status=0
      composer_output=$(composer install \
        --no-interaction \
        --no-progress \
        --prefer-dist \
        --no-dev --no-plugins --no-scripts 2>&1) || composer_status=$?
      if [ "$composer_status" -ne 0 ]; then
        echo_error "Composer failed"
        echo "$composer_output"
        if [ "$composer_status" -eq 2 ]; then
          CHECK_REASON=dependency_resolution
          return 1
        fi
        return 2
      fi
      DEPENDENCY_PACKAGES=$(jq -ce '.packages | select(type == "array")' composer.lock) || return 2
      if ! jq -c '[.[].require.php // ""]' <<< "$DEPENDENCY_PACKAGES" | validate_php_constraints; then
        echo_error "Invalid PHP requirement in resolved dependency metadata."
        return 2
      fi
    fi

    local lock_packages
    lock_packages=$(jq -r '.[].name' <<< "$DEPENDENCY_PACKAGES")
    mapfile -t extra_standards < <(detect_polyfill_standards "$lock_packages")
    if [ ${#extra_standards[@]} -gt 0 ]; then
      PHPCS_STANDARDS="${PHPCS_STANDARDS},$(IFS=,; echo "${extra_standards[*]}")"
      echo_info "Polyfill standards: ${extra_standards[*]}"
    fi

    local incompatible_ignores=()
    local incompatible_constraints=()
    mapfile -t incompatible_ignores < <(collect_vendor_ignores "$version" 0)
    if [ ${#incompatible_ignores[@]} -gt 0 ]; then
      for incomp_path in "${incompatible_ignores[@]}"; do
        local pkg_constraint
        pkg_constraint=$(jq -r --arg name "${incomp_path#vendor/}" '.[] | select(.name == $name) | .require.php // ""' <<< "$DEPENDENCY_PACKAGES")
        incompatible_constraints+=("$pkg_constraint")
        if [ "$SOURCE_TYPE" = "local" ]; then
          echo_error "Installed dependency ${incomp_path#vendor/} requires PHP ${pkg_constraint}, incompatible with PHP ${version}"
          dependency_constraint_fails=1
        else
          echo_warning "Skipping ${incomp_path#vendor/} — requires PHP ${pkg_constraint}, incompatible with PHP ${version}"
        fi
        phpcs_ignore="${phpcs_ignore},*/${incomp_path}/*"
      done
    fi

    local trusted_ignores=()
    if [ "$CHECK_DEPS" != "full" ]; then
      mapfile -t trusted_ignores < <(collect_vendor_ignores "$version" 1)
      for trusted_path in "${trusted_ignores[@]}"; do
        phpcs_ignore="${phpcs_ignore},*/${trusted_path}/*"
      done
      if [ ${#trusted_ignores[@]} -gt 0 ]; then
        echo_info "Trusting ${#trusted_ignores[@]} vendor package(s) with compatible PHP constraint (use --check-deps=full to include them)"
      fi
    fi

    if [ "$SHOW_DEPS" -eq 1 ]; then
      local total_pkgs
      total_pkgs=$(jq 'length' <<< "$DEPENDENCY_PACKAGES")
      if [ "$total_pkgs" -eq 0 ]; then
        echo_info "No dependencies."
        echo ""
      else
        echo_info "Dependencies (${total_pkgs} packages):"
        echo ""
        while IFS=$'\t' read -r pkg_name pkg_version; do
          local vendor_path="vendor/${pkg_name}"
          local is_ignored=0
          local is_trusted=0
          local pkg_php_req=""
          for i in "${!incompatible_ignores[@]}"; do
            if [ "${incompatible_ignores[$i]}" = "$vendor_path" ]; then
              is_ignored=1
              pkg_php_req="${incompatible_constraints[$i]}"
              break
            fi
          done
          if [ "$is_ignored" -eq 0 ]; then
            for trusted_path in "${trusted_ignores[@]}"; do
              if [ "$trusted_path" = "$vendor_path" ]; then
                is_trusted=1
                break
              fi
            done
          fi
          if [ "$is_ignored" -eq 1 ]; then
            local status="ignored"
            [ "$SOURCE_TYPE" = "local" ] && status="incompatible"
            printf "    %-40s  %-14s  \033[33m%s\033[0m (requires PHP %s)\n" "$pkg_name" "$pkg_version" "$status" "$pkg_php_req"
          elif [ "$is_trusted" -eq 1 ]; then
            printf "    %-40s  %-14s  \033[36mtrusted\033[0m\n" "$pkg_name" "$pkg_version"
          else
            printf "    %-40s  %-14s  \033[32mchecked\033[0m\n" "$pkg_name" "$pkg_version"
          fi
        done < <(jq -r '.[] | [.name, .version] | @tsv' <<< "$DEPENDENCY_PACKAGES" | sort)
        echo ""
      fi
    fi

  fi

  echo ""
  if [ "$dependency_constraint_fails" -eq 1 ]; then
    CHECK_REASON=dependency_constraint
    echo_error "Not compatible with PHP $version (installed dependency requirements)"
    return 1
  fi

  echo_info "Testing PHP $version..."
  echo ""

  local phpcs_args=(
    "${scan_dirs[@]}"
    --standard="$PHPCS_STANDARDS"
    --extensions=php
    --ignore="$phpcs_ignore"
    --basepath="$PROJECT_DIR"
    --runtime-set testVersion "$target"
  )

  local tmpjson tmperrors scanner_status=0
  CHECK_REASON=scanner_error
  tmpjson=$(mktemp) || return 2
  tmperrors=$(mktemp) || { rm -f "$tmpjson"; return 2; }
  phpcs --report=json "${phpcs_args[@]}" > "$tmpjson" 2>"$tmperrors" || scanner_status=$?

  if [ "$scanner_status" -gt 3 ] || ! jq -se '
    length == 1 and (.[0] | type == "object" and (.files | type == "object") and
    (.totals.errors | type == "number" and . >= 0 and . == floor) and
    (.totals.warnings | type == "number" and . >= 0 and . == floor))
  ' "$tmpjson" >/dev/null 2>&1; then
    echo_error "PHP_CodeSniffer failed or returned an invalid report for PHP $version."
    cat "$tmperrors" >&2
    rm -f "$tmpjson" "$tmperrors"
    return 2
  fi

  local phpcs_errors phpcs_warnings
  phpcs_errors=$(jq '.totals.errors' "$tmpjson")
  phpcs_warnings=$(jq '.totals.warnings' "$tmpjson")
  if [ "$scanner_status" -ne 0 ] && [ "$phpcs_errors" -eq 0 ] && [ "$phpcs_warnings" -eq 0 ]; then
    echo_error "PHP_CodeSniffer failed without reporting findings for PHP $version."
    rm -f "$tmpjson" "$tmperrors"
    return 2
  fi
  if [ "$JSON_MODE" -eq 1 ]; then
    cp "$tmpjson" "$REPORT_DIR/current.json" || return 2
  fi

  if [ "$verbose" -eq 1 ]; then
    php -r "
      \$data = json_decode(file_get_contents('$tmpjson'), true);
      if (!\$data) exit;
      \$showWarn = (bool) $SHOW_WARNINGS;
      \$sep = str_repeat('-', 80);
      foreach (\$data['files'] as \$file => \$info) {
        \$msgs = array_filter(\$info['messages'], fn(\$m) => \$m['type'] === 'ERROR' || \$showWarn);
        if (!\$msgs) continue;
        \$errCnt  = \$info['errors'];
        \$warnCnt = \$showWarn ? \$info['warnings'] : 0;
        \$affected = count(\$msgs);
        echo PHP_EOL . 'FILE: ' . \$file . PHP_EOL;
        echo \$sep . PHP_EOL;
        \$sum = 'FOUND ' . \$errCnt . ' ' . (\$errCnt === 1 ? 'ERROR' : 'ERRORS');
        if (\$warnCnt) \$sum .= ' AND ' . \$warnCnt . ' ' . (\$warnCnt === 1 ? 'WARNING' : 'WARNINGS');
        \$sum .= ' AFFECTING ' . \$affected . ' ' . (\$affected === 1 ? 'LINE' : 'LINES');
        echo \$sum . PHP_EOL . \$sep . PHP_EOL;
        foreach (\$msgs as \$msg) {
          \$type = \$msg['type'] === 'ERROR'
            ? \"\033[31mERROR  \033[0m\"
            : \"\033[33mWARNING\033[0m\";
          printf(' %4d | %s | %s' . PHP_EOL, \$msg['line'], \$type, \$msg['message']);
        }
        echo \$sep . PHP_EOL;
      }
    "
    if [ "$SHOW_WARNINGS" -eq 0 ] && [ "${phpcs_warnings:-0}" -gt 0 ]; then
      echo_warning "${phpcs_warnings} warning(s) found. Run with --show-warnings to display them."
    fi
  fi

  rm -f "$tmpjson" "$tmperrors"
  local result
  [ "${phpcs_errors:-1}" -gt 0 ] && result=1 || result=0
  CHECK_REASON=""
  [ "$result" -eq 0 ] || CHECK_REASON=source

  echo ""
  if [ $result -eq 0 ]; then
    echo_success "Compatible with PHP $version"
  else
    echo_error "Not compatible with PHP $version"
  fi

  return $result
}

# -----------------------
# INPUT
# -----------------------
REPO=""
REPO_VERSION=""
PHP_VERSION=""
CHECK_DEPS=""
MODE=check
FROM_PHP_VERSION=""
TO_PHP_VERSION=""
IGNORE_COMPOSER_PHP_VERSION=0
SHOW_DEPS=0
SHOW_WARNINGS=0
SCAN_DIRS=()

for arg in "$@"; do
  case $arg in
    -h|--help)
      print_help
      exit 0
      ;;
    --version)
      echo "php-compat-check $VERSION"
      exit 0
      ;;
    --check-deps)
      CHECK_DEPS="shallow"
      ;;
    --check-deps=*)
      val="${arg#*=}"
      if [ "$val" = "shallow" ] || [ "$val" = "full" ]; then
        CHECK_DEPS="$val"
      else
        echo_error "Invalid --check-deps value: '$val'. Use 'shallow' or 'full'."
        exit 2
      fi
      ;;
    --min-php-version)
      select_mode min
      ;;
    --max-php-version)
      select_mode max
      ;;
    --matrix)
      select_mode matrix
      ;;
    --format=json|--format=text) ;;
    --format=*)
      echo_error "Invalid output format: ${arg#*=}. Use text or json."
      exit 2
      ;;
    --from-php-version=*)
      FROM_PHP_VERSION="${arg#*=}"
      if ! known_php_version "$FROM_PHP_VERSION"; then
        echo_error "Unknown --from-php-version: $FROM_PHP_VERSION. Known versions: ${PHP_VERSIONS[*]}"
        exit 2
      fi
      ;;
    --to-php-version=*)
      TO_PHP_VERSION="${arg#*=}"
      if ! known_php_version "$TO_PHP_VERSION"; then
        echo_error "Unknown --to-php-version: $TO_PHP_VERSION. Known versions: ${PHP_VERSIONS[*]}"
        exit 2
      fi
      ;;
    --ignore-composer-php-version)
      IGNORE_COMPOSER_PHP_VERSION=1
      ;;
    --show-deps)
      SHOW_DEPS=1
      ;;
    --show-warnings)
      SHOW_WARNINGS=1
      ;;
    --scan-dirs=*)
      IFS=',' read -ra SCAN_DIRS <<< "${arg#*=}"
      ;;
    --source-version=*|--version=*)
      if [[ "$arg" == --version=* ]]; then
        echo_warning "--version=<ref> is deprecated; use --source-version=<version> instead." >&2
      fi
      val="${arg#*=}"
      if [ -z "$val" ]; then
        echo_error "--source-version requires a non-empty version."
        exit 2
      fi
      if [ -n "$REPO_VERSION" ] && [ "$REPO_VERSION" != "$val" ]; then
        echo_error "Conflicting source versions: '$REPO_VERSION' and '$val'."
        exit 2
      fi
      REPO_VERSION="${arg#*=}"
      ;;
    -*)
      echo_error "Unknown option: $arg"
      exit 2
      ;;
    *)
      if [ -z "$REPO" ]; then
        REPO="$arg"
      elif [ -z "$PHP_VERSION" ]; then
        PHP_VERSION="$arg"
      else
        echo_error "Unexpected argument: $arg"
        exit 2
      fi
      ;;
  esac
done

if [ -n "$PHP_VERSION" ] && ! known_php_version "$PHP_VERSION"; then
  echo_error "Unknown target PHP version: $PHP_VERSION. Known versions: ${PHP_VERSIONS[*]}"
  exit 2
fi
if [ "$MODE" != check ] && [ -n "$PHP_VERSION" ]; then
  echo_error "A target PHP version cannot be combined with a version search or matrix."
  exit 2
fi
if [ "$MODE" = check ] && { [ -n "$FROM_PHP_VERSION" ] || [ -n "$TO_PHP_VERSION" ]; }; then
  echo_error "Scan bounds require --min-php-version, --max-php-version, or --matrix."
  exit 2
fi
EXPLICIT_FROM_PHP_VERSION="$FROM_PHP_VERSION"
if [ "$MODE" != check ]; then
  FROM_PHP_VERSION="${FROM_PHP_VERSION:-${PHP_VERSIONS[0]}}"
  TO_PHP_VERSION="${TO_PHP_VERSION:-$MAX_PHP_VERSION}"
  select_scan_versions
  if [ ${#SCAN_PHP_VERSIONS[@]} -eq 0 ]; then
    echo_error "--from-php-version must not exceed --to-php-version."
    exit 2
  fi
fi

ORIGINAL_REPO="${PHP_COMPAT_CHECK_SOURCE:-$REPO}"
SOURCE_TYPE=""
case "$REPO" in
  package:*) SOURCE_TYPE="package"; REPO="${REPO#package:}" ;;
  repository:*) SOURCE_TYPE="repository"; REPO="${REPO#repository:}" ;;
  repo:*) SOURCE_TYPE="repository"; REPO="${REPO#repo:}" ;;
  local:*) SOURCE_TYPE="local"; REPO="${REPO#local:}" ;;
  .|..|./*|../*|/*) SOURCE_TYPE="local" ;;
esac

# Only package sources interpret a colon as a version constraint.
if [ "$SOURCE_TYPE" != "local" ] && [ "$SOURCE_TYPE" != "repository" ] && [[ "$REPO" =~ ^[a-zA-Z0-9_-]+/[a-zA-Z0-9_.-]+:.+$ ]]; then
  COLON_VERSION="${REPO#*:}"
  REPO="${REPO%%:*}"
  if [ -n "$REPO_VERSION" ] && [ "$REPO_VERSION" != "$COLON_VERSION" ]; then
    echo_error "Conflicting versions: ':' syntax specifies '$COLON_VERSION' but --source-version specifies '$REPO_VERSION'."
    exit 2
  fi
  REPO_VERSION="$COLON_VERSION"
fi

if [ -z "$REPO" ]; then
  print_help
  exit 2
fi

if [ -z "$SOURCE_TYPE" ]; then
  if [[ "$REPO" =~ ^[a-zA-Z0-9_-]+/[a-zA-Z0-9_.-]+$ ]]; then
    SOURCE_TYPE="package"
  else
    SOURCE_TYPE="repository"
  fi
fi

if [ "$SOURCE_TYPE" = "local" ]; then
  if [ ! -d "$REPO" ]; then
    echo_error "Local directory not found: $REPO"
    exit 2
  fi
  if [ -n "$REPO_VERSION" ]; then
    echo_error "--source-version is not supported for local projects; the current files are scanned."
    exit 2
  fi
fi

COMPOSER_HOME=$(composer config --global home 2>/dev/null)
for required_command in php jq phpcs; do
  if ! command -v "$required_command" >/dev/null; then
    echo_error "Required command is unavailable: $required_command"
    exit 2
  fi
done

# Resolve Packagist shorthand (vendor/package) to actual repository URL
if [ "$SOURCE_TYPE" = "package" ]; then
  if [[ ! "$REPO" =~ ^[a-zA-Z0-9_-]+/[a-zA-Z0-9_.-]+$ ]]; then
    echo_error "Invalid Packagist package: $REPO"
    exit 2
  fi
  echo_info "Resolving Packagist package: $REPO..."
  PACKAGIST_JSON=$(curl -sf "https://packagist.org/packages/${REPO}.json" 2>/dev/null || true)
  if [ -z "$PACKAGIST_JSON" ]; then
    echo_error "Could not resolve '$REPO' via Packagist. Is it a valid package name?"
    exit 2
  fi

  if [ -n "$REPO_VERSION" ] && [[ ! "$REPO_VERSION" =~ ^dev- ]]; then
    versions_json=$(echo "$PACKAGIST_JSON" | jq -r '[.package.versions | keys[] | select(startswith("dev-") | not) | select(endswith("-dev") | not)]' 2>/dev/null || true)
    REPO_VERSION=$(php -r "
      require '$COMPOSER_HOME/vendor/autoload.php';
      use Composer\Semver\Semver;
      \$versions = json_decode('$versions_json', true);
      \$matching = Semver::satisfiedBy(\$versions, '$REPO_VERSION');
      \$sorted = Semver::rsort(\$matching);
      echo \$sorted[0] ?? '';
    ")
    if [ -z "$REPO_VERSION" ]; then
      echo_error "No matching version found for constraint '$COLON_VERSION'."
      exit 2
    fi
  fi

  REPO=$(echo "$PACKAGIST_JSON" | jq -r '.package.repository // empty' 2>/dev/null || true)
  if [ -z "$REPO" ]; then
    echo_error "Could not find repository URL for package in Packagist response."
    exit 2
  fi
fi

TMP_DIR=""
if [ "$SOURCE_TYPE" = "local" ]; then
  PROJECT_DIR=$(cd -- "$REPO" && pwd -P)
  CLONED_VERSION="local files"
  CLONED_HASH=""
else
  TMP_DIR=$(mktemp -d)
  PROJECT_DIR="$TMP_DIR"
  CLONE_ARGS=(--depth=1)
  if [ -n "$REPO_VERSION" ]; then
    echo_info "Cloning repository at $REPO_VERSION..."
    CLONE_ARGS+=(--branch "${REPO_VERSION#dev-}")
  else
    echo_info "Cloning repository..."
  fi
  if ! git clone "${CLONE_ARGS[@]}" "$REPO" "$PROJECT_DIR" >/dev/null 2>&1; then
    echo_error "Failed to clone repository: $REPO"
    exit 2
  fi
  CLONED_VERSION=$(git -C "$PROJECT_DIR" describe --tags --exact-match 2>/dev/null || true)
  if [ -z "$CLONED_VERSION" ]; then
    branch=$(git -C "$PROJECT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    CLONED_VERSION="dev-${branch:-unknown}"
  fi
  CLONED_HASH=$(git -C "$PROJECT_DIR" rev-parse --short HEAD 2>/dev/null || true)
fi
cd "$PROJECT_DIR"
if [ -f composer.json ]; then
  if ! jq -se 'length == 1 and (.[0] | type == "object" and ((.require // {}) | type == "object") and
    ((.autoload // {}) | type == "object") and ((.require.php // "") | type == "string"))' composer.json >/dev/null 2>&1; then
    echo_error "Invalid composer.json; expected an object with valid require and autoload fields."
    exit 2
  fi
  if ! jq -c '[.require.php // ""]' composer.json | validate_php_constraints; then
    echo_error "Invalid Composer PHP constraint."
    exit 2
  fi
fi
ROOT_PHP_CONSTRAINT=""
if [ -f composer.json ]; then
  ROOT_PHP_CONSTRAINT=$(jq -r '.require.php // ""' composer.json)
fi
if [ ${#SCAN_DIRS[@]} -eq 0 ]; then
  mapfile -t SCAN_DIRS < <(detect_scan_dirs)
fi
DEPENDENCY_PACKAGES='[]'
LOCAL_DEV_PACKAGES=()
if [ "$SOURCE_TYPE" = "local" ] && [ -n "$CHECK_DEPS" ]; then
  load_local_dependencies || exit 2
  echo_info "Using installed local dependencies; no dependencies will be installed or updated."
fi
if [ -n "$CHECK_DEPS" ] && { [ "$SOURCE_TYPE" != "local" ] || [ -d vendor ]; } && [[ ! " ${SCAN_DIRS[*]} " =~ " . " ]] && [[ ! " ${SCAN_DIRS[*]} " =~ " vendor " ]]; then
  SCAN_DIRS+=("vendor")
fi

PHPCS_STANDARDS="PHPCompatibility"
if [ -z "$CHECK_DEPS" ] && [ -f composer.json ]; then
  require_packages=$(jq -r '.require // {} | keys[]' composer.json 2>/dev/null || true)
  mapfile -t extra_standards < <(detect_polyfill_standards "$require_packages")
  if [ ${#extra_standards[@]} -gt 0 ]; then
    PHPCS_STANDARDS="${PHPCS_STANDARDS},$(IFS=,; echo "${extra_standards[*]}")"
  fi
fi

BASE_PHPCS_STANDARDS="$PHPCS_STANDARDS"

# -----------------------
# NORMAL MODE
# -----------------------
if [ "$MODE" = check ]; then

  if [ -z "$PHP_VERSION" ]; then
    resolve_php_version
  fi

  print_config "compatibility check" "$PHP_VERSION"

  result=0
  run_check "$PHP_VERSION" 1 || result=$?
  RESULT_VERSION="$PHP_VERSION"

  exit "$result"
fi

# -----------------------
# VERSION SEARCH
# -----------------------

php_constraint=""
if [ "$IGNORE_COMPOSER_PHP_VERSION" -eq 0 ] && [ -f composer.json ]; then
  php_constraint=$(jq -r '.require.php // empty' composer.json 2>/dev/null || true)
fi

constraint_min=""
if [ -n "$php_constraint" ]; then
  constraint_min=$(constraint_min_version "$php_constraint")
fi

if [ "$MODE" = min ]; then
  print_config "find minimum PHP version" "${FROM_PHP_VERSION} – ${TO_PHP_VERSION}"
  echo_info "Finding minimum PHP version..."
elif [ "$MODE" = max ]; then
  print_config "find maximum PHP version" "${FROM_PHP_VERSION} – ${TO_PHP_VERSION}"
  echo_info "Finding highest compatible PHP version..."
  REVERSED_PHP_VERSIONS=()
  for ((i=${#SCAN_PHP_VERSIONS[@]}-1; i>=0; i--)); do
    REVERSED_PHP_VERSIONS+=("${SCAN_PHP_VERSIONS[$i]}")
  done
  SCAN_PHP_VERSIONS=("${REVERSED_PHP_VERSIONS[@]}")
else
  print_config "compatibility matrix" "${FROM_PHP_VERSION} – ${TO_PHP_VERSION}"
fi

ignore_hint="Use --ignore-composer-php-version to scan without constraint filtering."
MATRIX_ROWS=()
checked_count=0
failed_count=0

for v in "${SCAN_PHP_VERSIONS[@]}"; do
  if [ -n "$php_constraint" ] && ! satisfies_php_constraint "$v" "$php_constraint"; then
    MATRIX_ROWS+=("PHP $v  EXCLUDED (Composer requirement: $php_constraint)")
    record_result "$v" excluded composer_constraint
    continue
  fi
  result=0
  run_check "$v" || result=$?
  if [ "$result" -gt 1 ]; then
    echo_error "Analysis failed for PHP $v; the version search cannot be completed."
    exit 2
  fi
  checked_count=$((checked_count + 1))
  if [ "$MODE" = matrix ]; then
    if [ "$result" -eq 0 ]; then
      MATRIX_ROWS+=("PHP $v  PASS")
    else
      MATRIX_ROWS+=("PHP $v  FAIL")
      failed_count=$((failed_count + 1))
    fi
    continue
  fi
  if [ "$result" -eq 0 ]; then
    echo ""
    RESULT_VERSION="$v"
    if [ "$MODE" = min ]; then
      echo_success "Minimum supported PHP version: $v"
      if [ -n "$php_constraint" ] && { [ "$v" = "$constraint_min" ] || [ "$v" = "$EXPLICIT_FROM_PHP_VERSION" ]; }; then
        echo_note "$ignore_hint"
      fi
    else
      echo_success "Highest compatible PHP version checked: $v"
      if [ "$v" = "$TO_PHP_VERSION" ]; then
        echo_note "No upper incompatibility found within the checked versions."
      fi
      echo_note "Search limited to PHP $FROM_PHP_VERSION – $TO_PHP_VERSION; higher versions were not checked."
      if [ -n "$php_constraint" ]; then
        echo_note "Versions outside Composer requirement $php_constraint were excluded. $ignore_hint"
      fi
    fi
    exit 0
  fi
done

if [ "$MODE" = matrix ]; then
  echo ""
  echo_info "Compatibility matrix:"
  printf '%s\n' "${MATRIX_ROWS[@]}"
  echo_note "Each version is checked independently; passing endpoints do not imply a compatible range."
  if [ "$checked_count" -eq 0 ]; then
    echo_error "No eligible PHP versions found in range. $ignore_hint"
    exit 1
  fi
  [ "$failed_count" -eq 0 ] || exit 1
  exit 0
fi

echo ""
echo_error "No compatible PHP version found in range"
if [ -n "$php_constraint" ]; then
  echo "Note: $ignore_hint"
fi

exit 1
